# =============================================================================
# SISTEN — variáveis de ambiente
# Copie para `.env` e preencha. O `.env` é ignorado pelo git.
# =============================================================================

# ATENÇÃO: tudo com prefixo VITE_ é embutido no bundle JS e fica PÚBLICO para
# qualquer visitante. Nunca use VITE_ para segredo de servidor
# (service_role, chaves de API pagas, credenciais).

# -- Supabase (público por design; a proteção real vem das políticas de RLS) ---
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key"

# -- Segredos de servidor ------------------------------------------------------
# Usados apenas por Edge Functions e scripts locais. NÃO prefixar com VITE_.
# Configure em Supabase > Edge Functions > Secrets, não neste arquivo, quando
# for ambiente de produção.
# SUPABASE_SERVICE_ROLE_KEY="..."
# GEMINI_API_KEY="..."
# OPENROUTER_API_KEY="..."
# OPENROUTER_MODEL="deepseek/deepseek-v4-flash"
